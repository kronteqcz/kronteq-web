---
import type { Lang } from '../../i18n/strings';
import { getLang } from '../../i18n/strings';
import { languageHomeHref } from '../../i18n/routes';
import { contact } from '../../data/contact';

interface Props {
  lang?: Lang;
  /** Cesta na ekvivalent stránky v druhém jazyce (počítá BaseLayout). */
  switchLangHref?: string;
}

const { lang = 'cs', switchLangHref } = Astro.props;
const t = getLang(lang);
const langHref = switchLangHref ?? languageHomeHref(lang);
const telHref = `tel:${contact.phone.replace(/\s/g, '')}`;

const navItems = [
  { label: t.navServices, href: lang === 'en' ? '/en/services/' : '/sluzby/' },
  { label: t.navProducts, href: lang === 'en' ? '/en/products/' : '/produkty/' },
  { label: t.navTechnology, href: lang === 'en' ? '/en/technology/' : '/technologie/' },
  { label: t.navKnowledge, href: lang === 'en' ? '/en/knowledge-base/' : '/znalostni-baze/' },
  { label: t.navFaq, href: lang === 'en' ? '/en/faq/' : '/faq/' },
  { label: t.navIndustries, href: lang === 'en' ? '/en/industries/' : '/odvetvi/' },
  { label: t.navAbout, href: lang === 'en' ? '/en/about/' : '/o-nas/' },
  { label: t.navContact, href: lang === 'en' ? '/en/contact/' : '/kontakt/' },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/' || href === '/en/') return currentPath === href;
  return currentPath.startsWith(href);
}
const homeHref = lang === 'en' ? '/en/' : '/';
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <!-- Logo -->
    <a href={homeHref} class="logo" aria-label="Kronteq — zpět na úvod">
      <picture>
        <source srcset="/assets/logo-monogram-nav.webp" type="image/webp" />
        <img src="/assets/logo-monogram.png" alt="Kronteq logo" class="logo-img" width="38" height="38" />
      </picture>
      <span class="logo-name">KRONTEQ</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav-desktop" aria-label={lang === 'en' ? 'Main navigation' : 'Hlavní navigace'}>
      <ul role="list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class={isActive(item.href) ? 'nav-link active' : 'nav-link'}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Telefon — přímý kontakt na jedno kliknutí -->
      <a href={telHref} class="header-tel" aria-label={lang === 'en' ? `Call ${contact.phone}` : `Zavolat ${contact.phone}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span>{contact.phone}</span>
      </a>

      <!-- Lang switcher -->
      <a href={langHref} class="lang-switch" aria-label={`Switch to ${t.switchLang}`}>
        {t.switchLang}
      </a>

      <!-- CTA -->
      <a href={lang === 'en' ? '/en/contact/' : '/kontakt/'} class="header-cta">
        {t.navContactCta}
      </a>
    </div>

    <!-- Telefon na mobilu — vždy viditelný, mimo skládací menu -->
    <a href={telHref} class="header-tel-mobile" aria-label={lang === 'en' ? `Call ${contact.phone}` : `Zavolat ${contact.phone}`}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    </a>

    <!-- Mobile menu button -->
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={lang === 'en' ? 'Open navigation' : 'Otevřít navigaci'}
    >
      <span class="menu-bar" aria-hidden="true"></span>
      <span class="menu-bar" aria-hidden="true"></span>
      <span class="menu-bar" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Nav -->
  <nav class="nav-mobile" id="mobile-nav" aria-hidden="true">
    <ul role="list">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class={isActive(item.href) ? 'nav-link active' : 'nav-link'}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mobile-actions">
        <a href={langHref} class="lang-switch">{t.switchLang}</a>
        <a href={lang === 'en' ? '/en/contact/' : '/kontakt/'} class="btn-primary" style="font-size:0.875rem;padding:0.5rem 1.25rem;">
          {t.navContactCta}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const mobileNav = document.getElementById('mobile-nav')!;

  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 60);
    if (y > 200 && y > lastY) header.classList.add('hidden');
    else header.classList.remove('hidden');
    lastY = y;
  }, { passive: true });

  toggle.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    mobileNav.setAttribute('aria-hidden', String(isOpen));
    toggle.classList.toggle('open', !isOpen);
    mobileNav.classList.toggle('open', !isOpen);
    document.body.classList.toggle('nav-open', !isOpen);
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg-nav);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration) var(--ease), transform 0.4s var(--ease);
  }
  .site-header.scrolled { border-bottom-color: rgba(255,255,255,0.08); }
  .site-header.hidden { transform: translateY(-100%); }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 72px;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-img {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
    transition: box-shadow var(--duration) var(--ease);
  }
  .logo:hover .logo-img {
    box-shadow: 0 0 22px rgba(124, 58, 237, 0.55);
  }
  .logo-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    color: #fff;
  }

  /* Desktop nav */
  .nav-desktop { flex: 1; }
  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration) var(--ease), background var(--duration) var(--ease);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0.75rem;
    right: 0.75rem;
    height: 2px;
    background: var(--accent-light);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .nav-link.active { color: var(--accent-light); }
  .nav-link.active::after { transform: scaleX(1); }

  /* Header actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Telefon v hlavičce (desktop) */
  .header-tel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: color var(--duration) var(--ease);
  }
  .header-tel svg { stroke: var(--accent-light); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .header-tel:hover { color: #fff; }
  @media (max-width: 1100px) { .header-tel span { display: none; } }

  /* Telefon na mobilu */
  .header-tel-mobile {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .header-tel-mobile svg { stroke: var(--accent-light); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* Language switcher */
  .lang-switch {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255,255,255,0.15);
    transition: color var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }
  .lang-switch:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.4);
  }

  /* CTA */
  .header-cta {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: var(--accent);
    border-radius: 100px;
    padding: 0.45rem 1.1rem;
    transition: background var(--duration) var(--ease);
  }
  .header-cta:hover { background: var(--accent-hover); color: #fff; }

  /* Mobile toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .menu-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 1px;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .menu-toggle.open .menu-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle.open .menu-bar:nth-child(2) { opacity: 0; }
  .menu-toggle.open .menu-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile nav */
  .nav-mobile {
    display: none;
    padding: 1rem 1.5rem 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .nav-mobile ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav-mobile .nav-link {
    display: block;
    padding: 0.6rem 0.75rem;
    font-size: 1rem;
  }
  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.75rem 0;
    margin-top: 0.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  @media (max-width: 900px) {
    .nav-desktop { display: none; }
    .header-actions { display: none; }
    .header-tel-mobile { display: flex; }
    .menu-toggle { display: flex; margin-left: 0; }
    .nav-mobile.open { display: block; }
  }

  :global(body.nav-open) { overflow: hidden; }
</style>
